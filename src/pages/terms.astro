---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import LegalPage from '../components/LegalPage.astro';
import { brand } from '../config/brand';
import { termsOfService } from '../data/terms';
---

<BaseLayout title="Términos y condiciones" description={`Términos y condiciones de ${brand.name}. Consulta las condiciones de uso y servicio.`}>
  <Header slot="header" />

  <Banner title="Términos y condiciones" />

  <LegalPage effectiveDate={termsOfService.effectiveDate} sections={termsOfService.sections} />

  <Footer slot="footer" />
</BaseLayout>
