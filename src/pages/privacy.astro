---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import LegalPage from '../components/LegalPage.astro';
import { brand } from '../config/brand';
import { privacyPolicy } from '../data/privacy';
---

<BaseLayout title="Política de privacidad" description={`Política de privacidad de ${brand.name}. Descubre cómo tratamos tus datos.`}>
  <Header slot="header" />

  <Banner title="Política de privacidad" />

  <LegalPage effectiveDate={privacyPolicy.effectiveDate} sections={privacyPolicy.sections} />

  <Footer slot="footer" />
</BaseLayout>
