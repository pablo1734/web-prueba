---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { brand } from '../config/brand';
import { siteData } from '../data/siteData';

const { services } = siteData;
---

<BaseLayout title="Servicios" description={`Descubre todos los servicios de ${brand.name}: financiación, reparación, mantenimiento y más.`}>
  <Header slot="header" />

  <Banner title="Servicios" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Soluciones para tu vehículo</h2>
        <p class="mt-3 text-text-muted leading-relaxed">
          Desde la compra y venta hasta el taller mecánico, te acompañamos en cada etapa.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {services.map((service) => (
          <article class="rounded-lg border border-border bg-background p-6 shadow-sm">
            <h3 class="font-heading text-h3 font-semibold text-text">{service.title}</h3>
            <p class="mt-2 text-text-muted leading-relaxed">{service.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
