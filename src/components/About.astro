---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { aboutImage as localAboutImage } from '../config/images';

const PLACEHOLDER = 'https://images.unsplash.com/photo-1581578731548-c64695cc6952?w=900&q=80';

interface Props {
  topper?: string;
  heading?: string;
  body?: string[];
  benefits?: string[];
  ctaLabel?: string;
  ctaHref?: string;
  imageSrc?: ImageMetadata | string;
  imageAlt?: string;
}

const {
  topper = 'Quiénes somos',
  heading = 'Confianza que se demuestra en cada vehículo',
  body = [
    'En Automóviles Trafalgar trabajamos para ofrecerte una experiencia clara, cercana y profesional en cada compra, venta o servicio de mantenimiento.',
    'Nuestro objetivo es ayudarte a encontrar el vehículo adecuado con garantía, transparencia y atención personalizada desde el primer contacto.',
  ],
  benefits = [
    'Equipo profesional y cercano',
    'Transparencia total en cada operación',
    'Servicio de confianza y garantía',
  ],
  ctaLabel = 'Más sobre nosotros',
  ctaHref = '/nosotros',
  imageSrc = localAboutImage ?? PLACEHOLDER,
  imageAlt = 'Equipo profesional de Automóviles Trafalgar',
} = Astro.props;
---

<section class="py-section">
  <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">

    <!-- Image -->
    <div class="overflow-hidden rounded-lg shadow-lg">
      <Image
        src={imageSrc}
        alt={imageAlt}
        width={700}
        height={525}
        loading="lazy"
        decoding="async"
        class="size-full object-cover"
      />
    </div>

    <!-- Content -->
    <div class="space-y-5">
      <span class="text-topper font-bold uppercase tracking-widest text-accent">{topper}</span>
      <h2 class="font-heading text-h2 font-bold uppercase text-text">{heading}</h2>

      {body.map((paragraph) => (
        <p class="text-text-muted leading-relaxed">{paragraph}</p>
      ))}

      <!-- Benefits list -->
      <ul class="space-y-3 pt-2" role="list">
        {benefits.map((benefit) => (
          <li class="flex items-start gap-3">
            <span class="mt-0.5 shrink-0 text-accent font-bold" aria-hidden="true">&check;</span>
            <span class="text-text">{benefit}</span>
          </li>
        ))}
      </ul>

      <div class="pt-2">
        <a
          href={ctaHref}
          class="inline-flex min-h-11 items-center gap-2 rounded-md bg-primary px-6 py-3 text-base font-bold text-primary-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {ctaLabel}
        </a>
      </div>
    </div>
  </div>
</section>
